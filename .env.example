# =============================================================================
# RAJMOHAN PUBLIC PORTAL — ENVIRONMENT
#
# Copy to .env.local for development. NEVER commit .env or .env.local.
#
# NEXT_PUBLIC_* is compiled into the browser bundle. Anything secret must NOT
# carry that prefix (spec §13, §18, §33).
# =============================================================================

# --- Supabase (public — safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SECRET — server only, bypasses Row Level Security) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Observability (optional in development) ---
SENTRY_DSN=
